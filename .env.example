PORT=3000
# Admin account created on the very first run (change the password after logging in)
ADMIN_EMAIL=admin@ece.local
ADMIN_PASSWORD=Admin@12345
# Cookies are marked secure automatically over HTTPS; set 1 to force it
COOKIE_SECURE=0
MAX_UPLOAD_MB=25
# JWT_SECRET=   (optional locally; REQUIRED-ish on Render, render.yaml generates it)

# --- Render / production (render.yaml sets these) ---
# NODE_ENV=production
# DATA_DIR=/var/data/data
# UPLOAD_DIR=/var/data/uploads
